EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_OPENAI_BASE_URL=http://localhost:11434/v1/
OLLAMA_API_KEY=ollama

OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
JINA_API_KEY=
GENERATION_MODEL=google/gemma-4-26b-a4b-it
GROQ_MODEL=google/gemma-4-26b-a4b-it
GROQ_ALLOWED_MODELS=google/gemma-4-26b-a4b-it,google/gemma-4-26b-a4b-it:free,llama3.2:3b,gemma3:4b,qwen3.5:4b,gemini-3.6-flash,llama-3.3-70b-versatile
GROQ_ANSWER_MODEL_ORDER=google/gemma-4-26b-a4b-it,google/gemma-4-26b-a4b-it:free,llama3.2:3b,gemma3:4b,gemini-3.6-flash,llama-3.3-70b-versatile,qwen3.5:4b
GROQ_UTILITY_MODEL_ORDER=llama-3.1-8b-instant,qwen2.5:1.5b,gemma3:4b,llama-3.3-70b-versatile

DATABASE_URL=postgresql://postgres:password@localhost:5432/rag_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=10

# Bounded hybrid retrieval worker pool
HYBRID_RETRIEVAL_MAX_WORKERS=8
HYBRID_RETRIEVAL_MAX_PENDING=64
HYBRID_RETRIEVAL_QUEUE_TIMEOUT_SECONDS=10
AUTH_SECRET_KEY=replace-with-at-least-48-random-bytes
CONVERSATION_TOKEN_TTL_SECONDS=86400
APP_TIMEZONE=Africa/Nairobi

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_PROXY_CIDRS=
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_KEY_PREFIX=rag-chatbot:rate-limit
RATE_LIMIT_LOCAL_MAX_KEYS=10000
RATE_LIMIT_REDIS_COOLDOWN_SECONDS=30
CHAT_MAX_MESSAGE_CHARS=8000
CHAT_MAX_HISTORY_MESSAGES=20
WS_MAX_PAYLOAD_BYTES=65536
FILE_RECONCILE_INTERVAL_SECONDS=60
FILE_STAGING_RETENTION_HOURS=24
FILE_TRASH_RETENTION_HOURS=24
CRAWLER_ENABLED=true
